                <mxCell id="k1" value="&lt;b&gt;pure kernel&lt;/b&gt; — failures/ · constants/ · theme/ · l10n/ (generated)&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;imported by presentation 16 · application 8 · data 8 · domain 4 · infrastructure 3&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eef3f9;strokeColor=#d7e0ec;fontColor=#204d7d;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
