                <mxCell id="ke3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="k3" target="k4">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="ke4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="k4" target="k5">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="ke5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="k5" target="k6">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="k_n" value="The notifier is a family scoped to one symbol, so two detail screens never share state. &lt;i&gt;switchInterval()&lt;/i&gt; re-enters at the notifier: back to &lt;i&gt;loading&lt;/i&gt;, then the same chain again — the chart never reaches for the API itself." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="65" y="362" width="1060" height="18" as="geometry" />
                </mxCell>
                <mxCell id="L3" value="3 · FAVORITES AND PREFERENCES — on the device, no network at all" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="44" y="418" width="1112" height="212" as="geometry" />
                </mxCell>
                <mxCell id="s0" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;PRESENTATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;favorites_tab&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;preferences_screen&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="49" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="s1" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;PRESENTATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;FavoritesNotifier&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;PreferencesNotifier&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="209" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="s2" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;APPLICATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;ToggleFavoriteUseCase&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;Update… · Get…&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f7fafd;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="369" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="s3" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DATA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;FavoritesRepositoryImpl&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;symbols → entities&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="529" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="s4" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DATA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;FavoritesDatasource&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;PreferencesDatasource&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="689" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="s5" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;INFRASTRUCTURE&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;SharedPreferencesImpl&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;StorageInterface&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="849" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="s6" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;ON THE DEVICE&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;key–value store&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;'favorites' · pref_*&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1009" y="466" width="142" height="64" as="geometry" />
                </mxCell>
                <mxCell id="se0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="s0" target="s1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="s1" target="s2">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=9.5;fontColor=#9199a4;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" parent="1" edge="1" source="s2" target="s3" value="FavoritesRepository">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="s3" target="s4">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="s4" target="s5">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9199a4;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="s5" target="s6">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="s_n" value="Keys: &lt;i&gt;'favorites'&lt;/i&gt; — a string list toggled atomically down in the storage adapter, so two taps on the same symbol cannot race — plus &lt;i&gt;pref_locale&lt;/i&gt;, &lt;i&gt;pref_dark_mode&lt;/i&gt; and &lt;i&gt;pref_font_scale&lt;/i&gt;." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="65" y="536" width="1060" height="18" as="geometry" />
                </mxCell>
                <mxCell id="s_n2" value="&lt;i&gt;main.dart&lt;/i&gt; resolves SharedPreferencesImpl before &lt;i&gt;runApp&lt;/i&gt; and overrides &lt;i&gt;storageProvider&lt;/i&gt; with it — the single point where the app learns which adapter it got. PreferencesNotifier then drives ThemeMode, TextScaler and Locale on MaterialApp.router." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="65" y="562" width="1060" height="18" as="geometry" />
                </mxCell>
                <mxCell id="s_n3" value="The preferences pair is also the known leak: &lt;i&gt;preferences_dao.dart&lt;/i&gt; and &lt;i&gt;preferences_repository_impl.dart&lt;/i&gt; take a &lt;i&gt;SharedPreferences&lt;/i&gt; where &lt;i&gt;StorageInterface&lt;/i&gt; would do. Both are named in the architecture test; a third would fail it." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#8a5300;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="65" y="588" width="1060" height="18" as="geometry" />
                </mxCell>
                <mxCell id="f_fn" value="Dio is configured with 30 s connect, receive and send timeouts; the retry interceptor retries twice on 5xx and never on 4xx. &lt;i&gt;HttpClientFailure&lt;/i&gt; and &lt;i&gt;StorageFailure&lt;/i&gt; become a domain &lt;i&gt;Failure&lt;/i&gt; at the datasource, so no layer above ever sees a dio or shared_preferences type." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="44" y="652" width="1112" height="32" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
