<mxfile host="app.diagrams.net">
    <diagram id="fcar-layers" name="Layers">
        <mxGraphModel dx="926" dy="257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="title" value="Flutter Clean Arch + Riverpod" style="text;html=1;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#204d7d;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="700" height="40" as="geometry" />
                </mxCell>
                <mxCell id="subtitle" value="The six layers, and what crosses each boundary" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="64" width="700" height="24" as="geometry" />
                </mxCell>
                <mxCell id="n3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Domain&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#41618a&quot;&gt;The business core. Imports nothing but core.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#dfeaf6;strokeColor=#204d7d;strokeWidth=2.5;fontColor=#173a60;spacingLeft=14;spacingRight=14;spacingTop=16;" parent="1" vertex="1">
                    <mxGeometry x="320" y="100" width="280" height="360" as="geometry" />
                </mxCell>
                <mxCell id="n3a" value="&lt;b style=&quot;font-size:16px&quot;&gt;Entities · 4&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;CryptoQuoteEntity · Kline · FavoriteEntity · PreferencesEntity. Immutable (freezed), with the defaults and the arithmetic the app reasons about.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=12;spacingRight=12;" parent="n3" vertex="1">
                    <mxGeometry x="16" y="82" width="248" height="120" as="geometry" />
                </mxCell>
                <mxCell id="n3b" value="&lt;b style=&quot;font-size:16px&quot;&gt;Repository contracts · 4&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The interfaces Data implements. Every method returns &lt;i&gt;Either&amp;lt;Failure, T&amp;gt;&lt;/i&gt; — never an exception, never a DTO.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=12;spacingRight=12;" parent="n3" vertex="1">
                    <mxGeometry x="16" y="222" width="248" height="118" as="geometry" />
                </mxCell>
                <mxCell id="n2" value="&lt;b style=&quot;font-size:19px&quot;&gt;Application&lt;/b&gt;&lt;div style=&quot;font-size:13.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Orchestration. Eight use cases, one operation each: a use case composes a domain contract and hands back an entity or a Failure. No Flutter.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;spacingLeft=12;spacingRight=12;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;" parent="1" vertex="1">
                    <mxGeometry x="40" y="229" width="210" height="152" as="geometry" />
                </mxCell>
                <mxCell id="n1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Presentation&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;What the user sees and touches. Holds no business rule.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=16;" parent="1" vertex="1">
                    <mxGeometry x="40" y="429" width="210" height="482" as="geometry" />
                </mxCell>
                <mxCell id="n1a" value="&lt;b style=&quot;font-size:16px&quot;&gt;Screens · Widgets&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;3 screens, 2 tabs, 4 widgets. AutoRoute navigates; fl_chart draws the candles.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingTop=8;spacingLeft=12;spacingRight=12;" parent="n1" vertex="1">
                    <mxGeometry x="16" y="82" width="178" height="100" as="geometry" />
                </mxCell>
                <mxCell id="n1b" value="&lt;b style=&quot;font-size:13px&quot;&gt;Riverpod&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;Screen state, and the way in to a use case.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=12;spacingRight=12;spacingTop=16;" parent="n1" vertex="1">
                    <mxGeometry x="16" y="198" width="178" height="264" as="geometry" />
                </mxCell>
                <mxCell id="n1b2" value="&lt;b style=&quot;font-size:12px&quot;&gt;State · 4&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;A sealed freezed union: initial · loading · success · failure. The screen switches on it.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#c3d2e4;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=10;spacingRight=10;" parent="n1b" vertex="1">
                    <mxGeometry x="16" y="72" width="146" height="96" as="geometry" />
                </mxCell>
                <mxCell id="n1b3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Notifier · 4&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Reads the use case provider and publishes the next state.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#c3d2e4;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=10;spacingRight=10;" parent="n1b" vertex="1">
                    <mxGeometry x="16" y="180" width="146" height="68" as="geometry" />
                </mxCell>
                <mxCell id="n4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Data&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;Implements the contracts Domain declares.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=16;" parent="1" vertex="1">
                    <mxGeometry x="690" y="231" width="470" height="322" as="geometry" />
                </mxCell>
                <mxCell id="n4a" value="&lt;b style=&quot;font-size:16px&quot;&gt;Repository impls · 4&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Map a DTO/DAO to an entity, and an infra failure to a domain &lt;i&gt;Failure&lt;/i&gt;. The boundary, both ways.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=12;spacingRight=12;" parent="n4" vertex="1">
                    <mxGeometry x="16" y="68" width="189" height="98" as="geometry" />
                </mxCell>
                <mxCell id="n4h" value="&lt;b style=&quot;font-size:16px&quot;&gt;DTO · DAO · 3&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;CryptoQuoteDTO · KlineDTO · PreferencesDAO. A &lt;i&gt;toEntity()&lt;/i&gt; extension does the mapping — no hydrator class.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=12;spacingRight=12;" parent="n4" vertex="1">
                    <mxGeometry x="265" y="68" width="189" height="98" as="geometry" />
                </mxCell>
                <mxCell id="n4b" value="&lt;b style=&quot;font-size:16px&quot;&gt;Datasources · 4&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Speak to the outside only through &lt;i&gt;HttpClientInterface&lt;/i&gt; and &lt;i&gt;StorageInterface&lt;/i&gt;, and parse the raw payload into a DTO/DAO. The infra failure travels on untouched — translating it is the repository&apos;s job.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=12;spacingRight=12;" parent="n4" vertex="1">
                    <mxGeometry x="16" y="222" width="438" height="84" as="geometry" />
                </mxCell>
                <mxCell id="n5" value="&lt;b style=&quot;font-size:19px&quot;&gt;Infrastructure&lt;/b&gt;&lt;div style=&quot;font-size:13.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The two external packages, each isolated behind a contract: Dio via &lt;i&gt;HttpClientInterface&lt;/i&gt;, SharedPreferences via &lt;i&gt;StorageInterface&lt;/i&gt;. Returns a raw payload, or an infra failure rich in technical detail. No Flutter.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="690" y="613" width="470" height="116" as="geometry" />
                </mxCell>
                <mxCell id="amb1" value="&lt;b style=&quot;font-size:15px&quot;&gt;On the device&lt;/b&gt;&lt;div style=&quot;font-size:12px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;SharedPreferences&lt;br&gt;key–value&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=2;fontColor=#565658;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="730" y="785" width="180" height="100" as="geometry" />
                </mxCell>
                <mxCell id="amb2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Outside&lt;/b&gt;&lt;div style=&quot;font-size:12px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Binance public API&lt;br&gt;data-api.binance.vision&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#efefef;strokeColor=#b9c4d4;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#565658;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="940" y="785" width="180" height="100" as="geometry" />
                </mxCell>
                <mxCell id="x1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="n1" target="n2">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.57;entryDx=0;entryDy=0;" parent="1" edge="1" source="n2" target="n3">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="n4a" target="n3b" value="Entities /&lt;br&gt;Domain Failures">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="n4a" target="n4h">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2158;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="n4a" target="n4b">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7842;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="n4h" target="n4b">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="n4b" target="n5" value="Raw payload / Infra Failure">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2766;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="amb1" target="n5" value="DAO">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;strokeColor=#2d67a7;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7234;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="amb2" target="n5" value="DTO">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="x8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#a9c0da;strokeWidth=1.6;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=10.5;fontColor=#9199a4;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="n1" target="n3" value="the screen reads entities directly — the graph allows it">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="513" />
                            <mxPoint x="640" y="480" />
                            <mxPoint x="460" y="480" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="core1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Core&lt;/b&gt;&lt;div style=&quot;font-size:12.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Cross-cutting, not a layer: every layer may import it, it may import none. Ten files — the Failure union, the base URL, the theme, the generated l10n, and the AutoRoute table.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=16;spacingRight=16;" parent="1" vertex="1">
                    <mxGeometry x="40" y="952" width="1120" height="75" as="geometry" />
                </mxCell>
                <mxCell id="di1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Providers · dependency injection with Riverpod&lt;/b&gt;&lt;div style=&quot;font-size:12.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The other cross-cutting mechanism. Each class declares its provider in a &lt;i&gt;*_di.dart&lt;/i&gt; beside it — 19 of them, from the Dio adapter up to the use case — and the provider is resolved at the point of use. That is what makes every class substitutable, and what the test suite overrides.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;dashed=1;dashPattern=8 5;fontColor=#565658;spacingLeft=16;spacingRight=16;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1047" width="1120" height="90" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="fcar-enforcement" name="Enforcement">
        <mxGraphModel dx="926" dy="257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="g1" value="FLUTTER CLEAN ARCH + RIVERPOD · HOW THE GRAPH IS ENFORCED" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="44" y="16" width="520" height="18" as="geometry" />
                </mxCell>
                <mxCell id="g2" value="the layers are folders in one package, so nothing but a test stops domain/ from importing presentation/ — the rule is written down once, as code, and checked on every run" style="text;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="44" y="36" width="900" height="18" as="geometry" />
                </mxCell>
                <mxCell id="B1" value="1 · THE GRAPH, AS CODE — test/integrity/architecture_test.dart · reads every import under lib/ as text, no analyzer, no app" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="44" y="70" width="1112" height="232" as="geometry" />
                </mxCell>
                <mxCell id="p1" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;allowed{}&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;who may know about whom, beyond itself:&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;core&lt;/span&gt; → nothing&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;domain&lt;/span&gt; → core&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;application&lt;/span&gt; → core, domain&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;data&lt;/span&gt; → core, domain, infrastructure&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;infrastructure&lt;/span&gt; → core&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;presentation&lt;/span&gt; → core, domain, application&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="65" y="112" width="254" height="172" as="geometry" />
                </mxCell>
                <mxCell id="p2" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;wiringExceptions · wiringReach&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;composition has to know both sides, so it is named rather than left as a hole:&lt;br&gt;&lt;br&gt;&lt;i&gt;*_di.dart&lt;/i&gt; — application and presentation may see data; data may see infrastructure&lt;br&gt;&lt;br&gt;&lt;i&gt;core/routes/auto_route.dart&lt;/i&gt; — the route table names 3 screens and one entity&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="344" y="112" width="254" height="172" as="geometry" />
                </mxCell>
                <mxCell id="p3" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;pureLayers&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;&lt;span style=&quot;color:#173a60&quot;&gt;domain · application · infrastructure&lt;/span&gt; import no flutter, flutter_riverpod, flutter_localizations, auto_route or fl_chart.&lt;br&gt;&lt;br&gt;A layer that imports one of those has quietly become a UI layer — and its tests would need a widget binding. These run without one.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="623" y="112" width="254" height="172" as="geometry" />
                </mxCell>
                <mxCell id="p4" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;wrappedPackages&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;&lt;i&gt;dio&lt;/i&gt; and &lt;i&gt;shared_preferences&lt;/i&gt; may only be named inside infrastructure/, so swapping either is an edit in one folder.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#8a5300&quot;&gt;Two files in data/ still import shared_preferences directly. Both are listed, with a reason. The third one fails the test.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;strokeColor=#e8cfa6;" parent="1" vertex="1">
                    <mxGeometry x="902" y="112" width="254" height="172" as="geometry" />
                </mxCell>
                <mxCell id="B2" value="2 · ONE COMMAND — tool/arch.dart · make is a one-line face over it, and CI runs the same code path" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="44" y="318" width="1112" height="154" as="geometry" />
                </mxCell>
                <mxCell id="s1" value="&lt;b style=&quot;font-size:12px&quot;&gt;make setup&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;pub get · l10n&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
