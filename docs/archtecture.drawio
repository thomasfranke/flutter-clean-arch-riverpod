                <mxCell id="k0" value="CORE · lib/core/ — 10 files, 4 of them generated l10n — imported by every layer, imports none" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#f5f6f7;strokeColor=#dcdfe3;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#9199a4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" parent="1" vertex="1">
