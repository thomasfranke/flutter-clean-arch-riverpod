                </mxCell>
                <mxCell id="b2n" value="&lt;i&gt;arch verify&lt;/i&gt; runs them in that order and stops at the first failure. &lt;i&gt;arch test diff&lt;/i&gt; and &lt;i&gt;arch test last&lt;/i&gt; map changed files to tests by filename alone — which is why a test is named after the file it covers." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="62" y="432" width="1080" height="18" as="geometry" />
                </mxCell>
                <mxCell id="B3" value="3 · FIVE TEST LEVELS — 71 test files, four directories" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="44" y="500" width="1112" height="200" as="geometry" />
                </mxCell>
                <mxCell id="t1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Unit · 49&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;color:#9199a4&quot;&gt;test/unit/&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;every class alone, collaborators mocked with mocktail&lt;br&gt;&lt;br&gt;data 19 · application 16 · infrastructure 7 · presentation 4 · core 3&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="65" y="544" width="194" height="130" as="geometry" />
                </mxCell>
                <mxCell id="t2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Widget · 5&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;color:#9199a4&quot;&gt;test/widget/&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;screens and widgets pumped in a real tree, driven by WidgetTester against overridden providers&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="284" y="544" width="194" height="130" as="geometry" />
                </mxCell>
                <mxCell id="t3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Integration · 6&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;color:#9199a4&quot;&gt;test/integration/&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;the real classes wired together — use case → repository → datasource; only the true boundary is faked&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="503" y="544" width="194" height="130" as="geometry" />
                </mxCell>
                <mxCell id="t4" value="&lt;b style=&quot;font-size:13px&quot;&gt;E2E · 8&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;color:#9199a4&quot;&gt;integration_test/&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;the real app from main.dart on a device, against the live Binance API&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="722" y="544" width="194" height="130" as="geometry" />
                </mxCell>
                <mxCell id="t5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Integrity · 3&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;color:#9199a4&quot;&gt;test/integrity/&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;the repository rather than the product: the layer graph, and the arch CLI driven as a process&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dfeaf6;strokeColor=#204d7d;strokeWidth=1.5;fontColor=#173a60;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="941" y="544" width="194" height="130" as="geometry" />
                </mxCell>
                <mxCell id="b3n" value="Integrity is the level that makes the other four trustworthy: it is the only one that fails when the architecture erodes rather than when a feature breaks." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="65" y="678" width="1080" height="18" as="geometry" />
                </mxCell>
                <mxCell id="fn2" value="Read with the sources: &lt;i&gt;test/integrity/architecture_test.dart&lt;/i&gt; for the graph, &lt;i&gt;tool/arch.dart&lt;/i&gt; for the commands, &lt;i&gt;.github/workflows/ci.yml&lt;/i&gt; for the order CI runs them in." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="44" y="726" width="1112" height="18" as="geometry" />
                </mxCell>
            </root>
