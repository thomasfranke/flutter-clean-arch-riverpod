                <mxCell id="s5" value="&lt;b style=&quot;font-size:12px&quot;&gt;test&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;5 levels, with coverage&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
