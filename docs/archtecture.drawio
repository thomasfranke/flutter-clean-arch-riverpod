                    <mxGeometry x="426" y="360" width="160" height="56" as="geometry" />
                </mxCell>
                <mxCell id="s4" value="&lt;b style=&quot;font-size:12px&quot;&gt;codegen gate&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;rebuild · fail if the output moved&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f7fafd;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="608" y="360" width="160" height="56" as="geometry" />
