                </mxCell>
                <mxCell id="s2" value="&lt;b style=&quot;font-size:12px&quot;&gt;format&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;dart format --set-exit-if-changed&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="244" y="360" width="160" height="56" as="geometry" />
